*.tsx     text eol=lf
*.css     text eol=lf
*.scss    text eol=lf
*.less    text eol=lf
*.html    text eol=lf
*.json    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.toml    text eol=lf
*.md      text eol=lf
